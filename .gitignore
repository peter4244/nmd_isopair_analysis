# Data files - may be too large for git
*.bam
*.bam.bai

# R files
.Rhistory
.RData
.Rproj.user

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# macOS
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Large data and results directories
# ANCHORED to repo root 2026-07-21. A bare `results/` matches a dir named
# `results` at ANY depth — it was silently catching superseded/results/... and
# would catch any future nested results dir. Version_6.0 stays force-tracked.
/results/
data/
reference_files/
tmp/
counts/
isoseq/
oarfish_aligned_counts/
isocall/
isocall_dtu/
IGV/
isoseq_pipeline/
isocall_pipeline/
resources/
sqanti/

# Literature review PDFs (kept locally, not in history; the .md text review is tracked)
lit_review/**/*.pdf

# Standalone PDF deliverables and rendered HTML reports (regenerable / large)
pilot_endothelial/*.pdf
code/nonNMD_*.html

# R binary files
*.rds
*.RDS

# Large generated files
*_proportions_*.tsv
*_interpretation_*.tsv
code/*_full_table.csv

# Large DGE result files (can be regenerated)
longread_dge/*.csv
shortread_dge/*.csv
isocall_dge/limma/**/*.csv
isocall_dge/mashr/*.csv

# Yul-canonical DGE artifacts — final versions come from Yul's pipeline,
# not from this repo. Pete's local copies stay out of git.
shortread_dge/mashr/
isocall_dge/old/

# Archive folders - old versions and backups
**/archive/
# Exempt archive dirs that hold TRACKED files (paper/archive, the superseded/
# tree). Without these, `**/archive/` silently untracks them — it nearly
# swallowed all 158 archived files on 2026-07-21.
!paper/archive/
!superseded/**/archive/
**/archive_*/

# Large cache files from R Markdown
**/*_cache/
*.RData

# Large HTML reports (can be regenerated)
code/*_dge_*.html
code/isoform_transition_*.html

# Linked external repos (canonical location is sibling, not nested)
nmd_orf_model_v5_4ct/

# Verification / pre-rewrite backup snapshots (regenerable; not source of truth)
**/.verify_pass*_backup/
*.pre_enst_update
*.pre_rewrite

# node deps for the SF docx builder (kept local, not tracked)
paper/node_modules/

# Yul's analysis data bundle — primary-cell-derived intermediates.
# Local-verification use only; NEVER committed (this repo auto-pushes to public GitHub).
# Not deposited either, per reproducibility standard D-5 (raw reads + code only).
nmd_fig_data/

# Tan et al. (2025) supplementary tables — another paper published data.
# Pulled locally for verification only. NOT redistributed (see plan W-2); the
# download manifest lives in code/upstream/tan_reanalysis/README.md.
code/upstream/tan_reanalysis/data/
code/upstream/tan_reanalysis/output/
