/*
 * SLURM profile configuration for BWH cluster
 */

process {
    executor = 'slurm'

    // isocall is a static binary in bin/ — Nextflow adds bin/ to PATH automatically
    // samtools available via module
    beforeScript = 'module load samtools/1.21'

    withName: 'PREP_ISOFORMS' {
        queue = 'linux12hr'
    }

    withName: 'FAIDX' {
        queue = 'linux12hr'
    }

    withName: 'PROFILE' {
        queue = 'linux12hr'
    }

    withName: 'MERGE' {
        queue = 'linux12hr'
    }

    withName: 'CALL' {
        queue  = 'linux01'
        cpus   = 12
        memory = 64.GB
        time   = 12.h
    }
}
