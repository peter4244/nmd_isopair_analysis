/*
 * isocall Nextflow Pipeline Configuration
 *
 * Joint RNA isoform calling across PacBio IsoSeq samples
 * using isocall v0.15.0
 */

params {
    // Input
    samplesheet    = null       // CSV: sample,bam
    genome_fasta   = null       // GRCh38 FASTA
    annotation_gtf = null       // GENCODE GTF

    // Optional
    isocall_config = null       // TOML config for call step
    output_prefix  = 'isocall'  // Prefix for output files

    // Output
    outdir         = 'results'
}

// Load base resource config
includeConfig 'conf/base.config'

profiles {
    docker {
        includeConfig 'conf/docker.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}

// Timeline and report
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
